{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AnarchI-Technologies-MAIN/anarchi-observation-contracts/schemas/evidence-envelope-v2.json",
  "title": "AnarchI Evidence Envelope v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_kind", "observation_id", "source", "source_instance", "cycle_id", "window_started_at", "window_ended_at", "observed_at", "emitted_at", "skew_ms", "allowed_skew_ms", "late", "stale", "missed_cycle", "severity", "state", "domain", "condition", "condition_family", "subject", "measured_evidence", "confidence", "incident_code", "evidence_hash", "expires_at", "provenance"],
  "properties": {
    "schema_version": {"const": "anarchi.evidence.v2"},
    "evidence_kind": {"enum": ["observation", "observer_cycle_participation"]},
    "observation_id": {"type": "string", "pattern": "^obs_[0-9a-f]{32}$"},
    "source": {"enum": ["watchtower", "spine-spire", "therma-stats"]},
    "source_instance": {"type": "string", "minLength": 1, "maxLength": 160},
    "cycle_id": {"type": "string", "pattern": "^obs:v1:"},
    "window_started_at": {"type": "string", "format": "date-time"},
    "window_ended_at": {"type": "string", "format": "date-time"},
    "observed_at": {"type": "string", "format": "date-time"},
    "emitted_at": {"type": "string", "format": "date-time"},
    "skew_ms": {"type": "number", "minimum": 0},
    "allowed_skew_ms": {"type": "number", "minimum": 0},
    "late": {"type": "boolean"}, "stale": {"type": "boolean"}, "missed_cycle": {"type": "boolean"},
    "severity": {"enum": ["info", "warning", "critical"]},
    "state": {"enum": ["healthy", "degraded", "unhealthy", "unknown"]},
    "domain": {"type": "string", "minLength": 1, "maxLength": 128},
    "condition": {"type": "string", "minLength": 1, "maxLength": 160},
    "condition_family": {"type": "string", "minLength": 1, "maxLength": 160},
    "subject": {"type": "string", "minLength": 1, "maxLength": 512},
    "measured_evidence": {"type": "object"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "incident_code": {"oneOf": [{"type": "string", "pattern": "^inc_[0-9a-f]{32}$"}, {"type": "null"}]},
    "evidence_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "expires_at": {"type": "string", "format": "date-time"},
    "provenance": {"type": "object", "required": ["producer", "producer_version", "host", "transport"], "properties": {"producer": {"type": "string"}, "producer_version": {"type": "string"}, "host": {"type": "string"}, "transport": {"const": "pulse-local-ingress/switch-board"}}, "additionalProperties": false}
  },
  "allOf": [{"if": {"properties": {"evidence_kind": {"const": "observer_cycle_participation"}}}, "then": {"properties": {"incident_code": {"type": "null"}}}}, {"if": {"properties": {"evidence_kind": {"const": "observation"}}}, "then": {"properties": {"incident_code": {"type": "string", "pattern": "^inc_[0-9a-f]{32}$"}}}}]
}
